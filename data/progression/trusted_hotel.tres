[gd_resource type="Resource" script_class="ObjectiveDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://progression/objectives/objective_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"trusted_hotel"
display_name = "Hotel de referência"
description = "Conclua vinte visitas e alcance reputação 65 após completar a operação."
prerequisite = &"steady_service"
requirements = {"completed": 20, "reputation": 65}
unlocks = Array[StringName]([&"bedroom_5", &"reception_5", &"restaurant_5"])
reward_text = "Conquista o título Hotel de referência e libera N5 de quartos, recepções e bistrôs."
